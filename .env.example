NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
MONGODB_URI=mongodb://127.0.0.1:27017/commandctr
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOG_LEVEL=info
AWS_REGION=us-east-1
AWS_S3_BUCKET=commandctr-local
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
RESEND_API_KEY=replace-me
RESEND_FROM_EMAIL=no-reply@commandctr.local
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-04
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret
SHOPIFY_APP_URL=
SHOPIFY_REDIRECT_URI=
SHOPIFY_ADMIN_ACCESS_TOKEN=your_shopify_admin_access_token
FRONTEND_URL=http://localhost:3001
ENCRYPTION_SECRET=change_me_32_characters_minimum!
