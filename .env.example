NODE_ENV=development
TRUST_PROXY=true
PORT=5000
API_PREFIX=/api/v1
MONGODB_URI=mongodb://127.0.0.1:27017/commandctr
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOG_LEVEL=info
AWS_REGION=us-east-1
AWS_S3_BUCKET=commandctr-local
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
RESEND_API_KEY=replace-me
RESEND_FROM_EMAIL=no-reply@commandctr.local
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-04
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret
SHOPIFY_APP_URL=
SHOPIFY_REDIRECT_URI=
SHOPIFY_ADMIN_ACCESS_TOKEN=your_shopify_admin_access_token
EBAY_ENVIRONMENT=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=
EBAY_REDIRECT_URI=
EBAY_SCOPES=https://api.ebay.com/oauth/api_scope/sell.account.readonly https://api.ebay.com/oauth/api_scope/sell.inventory
EBAY_API_BASE_URL=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_MERCHANT_LOCATION_KEY=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_DEFAULT_CATEGORY_ID=
EBAY_DEFAULT_CURRENCY=USD
EBAY_LISTING_FORMAT=FIXED_PRICE
EBAY_LISTING_DURATION=GTC
EBAY_DEFAULT_CONDITION=NEW
EBAY_SANDBOX_CLIENT_ID=
EBAY_SANDBOX_CLIENT_SECRET=
EBAY_SANDBOX_RU_NAME=
EBAY_SANDBOX_REDIRECT_URI=
EBAY_SANDBOX_AUTH_URL=https://auth.sandbox.ebay.com/oauth2/authorize
EBAY_SANDBOX_TOKEN_URL=https://api.sandbox.ebay.com/identity/v1/oauth2/token
EBAY_PRODUCTION_CLIENT_ID=
EBAY_PRODUCTION_CLIENT_SECRET=
EBAY_PRODUCTION_RU_NAME=
EBAY_PRODUCTION_REDIRECT_URI=
EBAY_PRODUCTION_AUTH_URL=https://auth.ebay.com/oauth2/authorize
EBAY_PRODUCTION_TOKEN_URL=https://api.ebay.com/identity/v1/oauth2/token
ETSY_CLIENT_ID=
ETSY_REDIRECT_URI=
ETSY_SCOPES=shops_r
ETSY_AUTH_URL=https://www.etsy.com/oauth/connect
ETSY_TOKEN_URL=https://api.etsy.com/v3/public/oauth/token
ETSY_API_BASE_URL=https://api.etsy.com/v3/application
ETSY_SHARED_SECRET=
FRONTEND_URL=http://localhost:3001
ENCRYPTION_SECRET=change_me_32_characters_minimum!
